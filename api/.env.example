# Database
DATABASE_URL="postgresql://postgres:<yourpassword>@localhost:5432/minnauz?schema=public"

# JWT (production'da majburiy)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS uchun ruxsat etilgan originlar (vergul bilan ajratilgan)
CORS_ORIGINS="http://localhost:3000"

# Shu email bilan kirgan foydalanuvchi avtomatik SUPER_ADMIN bo'ladi
ADMIN_EMAIL=""

# Google OAuth
GOOGLE_CLIENT_ID=""

# SMTP (OTP emaillari uchun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="MinnaUz <noreply@example.com>"

# Groq AI (console.groq.com - Llama 3.3 70B)
GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Cloudflare R2 Storage (S3-compatible Object Storage)
# Cloudflare Dashboard > R2 > Manage R2 API Tokens or bucket settings
R2_ACCOUNT_ID="<your-cloudflare-account-id>"
R2_ACCESS_KEY_ID="<your-r2-access-key-id>"
R2_SECRET_ACCESS_KEY="<your-r2-secret-access-key>"
R2_BUCKET="minnauz-storage"
#
# R2_PUBLIC_URL - public fayllar (rasm, avatar) uchun CDN URL:
#
# 1. TEZKOR (domen shart emas):
#    Cloudflare Dashboard > R2 > minnauz-storage bucket > Settings > Public Access > Enable
#    Ko'rsatiladigan URL: https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
#    R2_PUBLIC_URL="https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev"
#
# 2. CUSTOM DOMAIN (tavsiya etiladi):
#    Cloudflare Dashboard > R2 > minnauz-storage bucket > Settings > Custom Domains > Connect Domain
#    Domain: media.minnauz.uz (yoki boshqa) > Activate
#    R2_PUBLIC_URL="https://media.minnauz.uz"
#
R2_PUBLIC_URL="https://media.minna.uz"


# Muhit
NODE_ENV="development"
PORT="3001"
