# Database
DATABASE_URL="postgresql://postgres:<yourpassword>@localhost:5432/minnauz?schema=public"

# JWT (production'da majburiy)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS uchun ruxsat etilgan originlar (vergul bilan ajratilgan)
CORS_ORIGINS="http://localhost:3000"

# Shu email bilan kirgan foydalanuvchi avtomatik SUPER_ADMIN bo'ladi
ADMIN_EMAIL=""

# Google OAuth
GOOGLE_CLIENT_ID=""

# SMTP (OTP emaillari uchun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="MinnaUz <noreply@example.com>"

# Groq AI (console.groq.com - Llama 3.3 70B)
GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Muhit
NODE_ENV="development"
PORT="3001"
