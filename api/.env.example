# Database (AWS RDS PostgreSQL)
DATABASE_URL="postgresql://<db_user>:<db_password>@<rds_endpoint>:5432/minnauz?schema=public&sslmode=require"

# AWS S3 storage
AWS_REGION="us-east-1"
AWS_S3_BUCKET="minnauz-production"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional: use an IAM role in AWS instead of access keys
AWS_S3_PUBLIC_BASE_URL=""
AWS_S3_ENDPOINT=""
AWS_S3_FORCE_PATH_STYLE="false"
# Public backend origin used for stable private-file URLs
API_PUBLIC_URL="http://localhost:3001"

# JWT (production'da majburiy)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS uchun ruxsat etilgan originlar (vergul bilan ajratilgan)
CORS_ORIGINS="http://localhost:3000"

# Shu email bilan kirgan foydalanuvchi avtomatik SUPER_ADMIN bo'ladi
ADMIN_EMAIL=""

# Google OAuth
GOOGLE_CLIENT_ID=""

# SMTP (OTP emaillari uchun)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
SMTP_FROM="MinnaUz <noreply@example.com>"

# Groq AI (console.groq.com - Llama 3.3 70B)
GROQ_API_KEY=""
GROQ_API_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Muhit
NODE_ENV="development"
PORT="3001"
