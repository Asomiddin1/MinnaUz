generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TEACHER
  ADMIN
  SUPER_ADMIN
}

enum CourseLevel {
  N5
  N4
  N3
  N2
  N1
  OTHER
}

enum ExerciseType {
  QUIZ
  AUDIO_LISTENING
  FILL_BLANK
  MATCHING
}

enum BannerAudience {
  ALL
  USER
  TEACHER
}

enum BannerActionType {
  LINK
  PLAN_MODAL
  NOTIFICATION_DETAIL
}

enum NotificationAudience {
  ALL
  USER
  TEACHER
  INDIVIDUAL
}

enum NotificationType {
  INFO
  ANNOUNCEMENT
  SYSTEM
  UPDATE
  PROMO
}

enum FlashcardStatus {
  LEARNING
  MASTERED
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  fullName      String?
  avatarUrl     String?
  googleAvatarUrl String?
  role          Role            @default(USER)
  isVerified    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sessions      DeviceSession[]
  otpCodes      OtpCode[]

  // Author relations
  authoredCourses Course[]      @relation("CourseAuthor")
  
  // Progress relations
  lessonProgress  UserLessonProgress[]
  kotobaProgress  UserKotobaProgress[]
  kanjiProgress   UserKanjiProgress[]
  
  // Teacher / Group relations
  teachingGroups  Group[]       @relation("TeacherGroups")
  groupMemberships GroupMember[]
  studyActivities UserStudyActivity[]
  studyPlan       UserStudyPlan?
  notifications   UserNotification[]
  testResults     UserTestResult[]
  coins           Int                  @default(100)
  streakDays      Int                  @default(0)
  streakFrozen    Boolean              @default(false)
  avatarFrame     String?
  coinTransactions CoinTransaction[]
  inventory       UserInventoryItem[]
  subscriptions   UserSubscription[]
  paymentTransactions PaymentTransaction[]
  feedbacksGiven    TeacherFeedback[] @relation("TeacherFeedbackGiven")
  feedbacksReceived TeacherFeedback[] @relation("StudentFeedbackReceived")
  storedFiles       StoredFile[]

  @@map("users")
}

model Banner {
  id             String           @id @default(uuid())
  title          String
  desc           String
  tag            String           @default("Yangilik")
  tagIcon        String           @default("Sparkles")
  image          String           @default("/banner_art.png")
  btnText        String           @default("Batafsil")
  btnUrl         String?
  btnIcon        String           @default("ArrowRight")
  actionType     BannerActionType @default(LINK)
  notificationId String?
  order          Int              @default(0)
  isActive       Boolean          @default(true)
  isDismissible  Boolean          @default(false)
  targetAudience BannerAudience   @default(ALL)
  isDefault      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  notification   Notification?    @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@map("banners")
}

model Notification {
  id           String               @id @default(uuid())
  title        String
  message      String
  content      String?
  imageUrl     String?
  videoUrl     String?
  actionUrl    String?
  actionText   String?
  audience     NotificationAudience @default(ALL)
  targetUserId String?
  type         NotificationType     @default(ANNOUNCEMENT)
  isPublished  Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  banners      Banner[]
  userReceipts UserNotification[]

  @@map("notifications")
}

model UserNotification {
  id             String       @id @default(uuid())
  userId         String
  notificationId String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationId])
  @@map("user_notifications")
}

model UserStudyPlan {
  id              String      @id @default(uuid())
  userId          String      @unique
  targetLevel     CourseLevel @default(N5)
  weeklyGoalHours Int         @default(4)
  dailyMinutes    Int         @default(35)
  targetMonths    Int         @default(6)
  isConfigured    Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_study_plans")
}

model UserStudyActivity {
  id           String   @id @default(uuid())
  userId       String
  date         String   // e.g. "2026-08-28"
  minutesSpent Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("user_study_activities")
}

model DeviceSession {
  id            String   @id @default(uuid())
  userId        String
  deviceId      String   @unique
  deviceName    String?  // e.g. "Chrome on Windows", "Safari on iPhone"
  os            String?
  browser       String?
  ipAddress     String?
  refreshToken  String   // Hashed refresh token
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("device_sessions")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("otp_codes")
}

model Course {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  description String?
  level       CourseLevel  @default(N5)
  coverImage  String?
  authorId    String?
  isPublished Boolean      @default(true)
  order       Int          @default(1)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author      User?        @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  modules     CourseModule[]
  groups      Group[]
  feedbacks   TeacherFeedback[]
  tests       JlptTest[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("course_modules")
}

model Lesson {
  id              String       @id @default(uuid())
  moduleId        String
  title           String
  japaneseTitle   String?      // e.g. "第1課"
  slug            String?
  order           Int          @default(1)
  videoUrl        String?
  summary         String?
  attachments     Json?        // Array of { title: string, fileUrl: string, type: string }
  deleteRequested Boolean      @default(false)
  deleteReason    String?
  kaiwaScenario   Json?        // AI conversational prompt and guidelines
  isPublished     Boolean      @default(true)
  isFree          Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  module          CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  kotobaItems     KotobaItem[]
  bunpouItems     BunpouItem[]
  kanjiItems      KanjiItem[]
  renshuuItems    RenshuuItem[]
  userProgress    UserLessonProgress[]
  feedbacks       TeacherFeedback[]

  @@map("lessons")
}

model KotobaItem {
  id                  String   @id @default(uuid())
  lessonId            String
  word                String   // e.g. わたし or 私
  furigana            String?  // e.g. わたし
  romaji              String?  // e.g. watashi
  meaningUz           String   // e.g. men
  meaningRu           String?  // e.g. я
  meaningEn           String?  // e.g. I, me
  partOfSpeech        String?  // e.g. Ot, Fe'l, Sifat
  audioUrl            String?
  sampleSentence      String?  // e.g. わたしは がくせいです。
  sampleSentenceUz    String?  // e.g. Men talabaman.
  order               Int      @default(1)

  lesson              Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userProgress        UserKotobaProgress[]

  @@map("kotoba_items")
}

model UserKotobaProgress {
  id             String           @id @default(uuid())
  userId         String
  kotobaId       String
  status         FlashcardStatus  @default(LEARNING)
  reviewCount    Int              @default(0)
  lastReviewedAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kotoba         KotobaItem       @relation(fields: [kotobaId], references: [id], onDelete: Cascade)

  @@unique([userId, kotobaId])
  @@map("user_kotoba_progress")
}

model BunpouItem {
  id            String   @id @default(uuid())
  lessonId      String
  title         String   // e.g. ~ は ~ です
  structure     String?  // e.g. N1 は N2 です
  explanationUz String   // Grammar explanation in Uzbek
  explanationRu String?  // Grammar explanation in Russian
  examples      Json?    // Array of { japanese: string, romaji: string, uzbek: string }
  order         Int      @default(1)

  lesson        Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("bunpou_items")
}

model KanjiItem {
  id              String   @id @default(uuid())
  lessonId        String
  character       String   // e.g. 日
  onyomi          String?  // e.g. ニチ, ジツ
  kunyomi         String?  // e.g. ひ, -び, -か
  meaningUz       String   // e.g. Quyosh, kun
  meaningRu       String?  // e.g. Солнце, день
  strokeCount     Int?     // e.g. 4
  strokeOrderData String?  // SVG path or image url
  radical         String?  // e.g. 日
  examples        Json?    // Array of { word: string, reading: string, meaning: string }
  order           Int      @default(1)

  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userProgress    UserKanjiProgress[]

  @@map("kanji_items")
}

model UserKanjiProgress {
  id             String           @id @default(uuid())
  userId         String
  kanjiId        String
  status         FlashcardStatus  @default(LEARNING)
  reviewCount    Int              @default(0)
  lastReviewedAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kanji          KanjiItem        @relation(fields: [kanjiId], references: [id], onDelete: Cascade)

  @@unique([userId, kanjiId])
  @@map("user_kanji_progress")
}

model RenshuuItem {
  id            String       @id @default(uuid())
  lessonId      String
  type          ExerciseType @default(QUIZ)
  question      String
  audioUrl      String?
  options       Json?        // Array of options: string[]
  correctAnswer String       // Exact string of correct answer
  explanation   String?
  order         Int          @default(1)

  lesson        Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("renshuu_items")
}

model UserLessonProgress {
  id                String    @id @default(uuid())
  userId            String
  lessonId          String
  completedSections Json?     // Array of completed tab keys e.g. ["kotoba", "bunpou", "kanji", "renshuu"]
  quizScore         Int?      // Score percentage e.g. 100
  isCompleted       Boolean   @default(false)
  lastStudiedAt     DateTime  @default(now())

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson            Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  inviteCode  String        @unique
  teacherId   String
  courseId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teacher     User          @relation("TeacherGroups", fields: [teacherId], references: [id], onDelete: Cascade)
  course      Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  members     GroupMember[]

  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

enum TestCategory {
  MOCK_EXAM
  VOCABULARY_KANJI
  GRAMMAR_READING
  LISTENING
}

model JlptTest {
  id              String         @id @default(uuid())
  title           String
  slug            String         @unique
  description     String?
  level           CourseLevel    @default(N5)
  category        TestCategory   @default(MOCK_EXAM)
  durationMinutes Int            @default(105)
  passingScore    Int            @default(60) // Foizda (masalan, 60%)
  totalScore      Int            @default(180)
  audioUrl        String?        // Choukai bo'limi uchun yagona doimiy audio trek
  order           Int            @default(1)
  isPublished     Boolean        @default(true)
  isPremium       Boolean        @default(false)
  authorId        String?
  courseId        String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions       JlptQuestion[]
  userResults     UserTestResult[]

  @@map("jlpt_tests")
}

model JlptQuestion {
  id             String      @id @default(uuid())
  testId         String
  section        String      @default("KOTOBA") // KOTOBA, BUNPOU, DOKKAI, CHOUKAI
  mondaiTitle    String?     // Masalan: "問題1: つぎの ぶんの の ことばは どう かきますか"
  questionNumber Int         @default(1)
  questionText   String
  contextText    String?     // O'qish matni, dialog yoki kontekst
  imageUrl       String?     // Rasmli savollar uchun
  options        Json        // 4 ta variant (string[])
  correctAnswer  String      // To'g'ri variant matni
  explanation    String?     // O'zbek tilidagi batafsil tushuntirish
  points         Int         @default(2)
  order          Int         @default(1)

  test           JlptTest    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("jlpt_questions")
}

model UserTestResult {
  id               String      @id @default(uuid())
  userId           String
  testId           String
  score            Int         // Olingan ball (masalan 152)
  percentage       Int         // Foiz (masalan 84%)
  isPassed         Boolean     @default(false)
  timeSpentSeconds Int         @default(0)
  answers          Json        // [{ questionId, selectedAnswer, isCorrect }]
  completedAt      DateTime    @default(now())

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  test             JlptTest    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@map("user_test_results")
}

// ==========================================
// STORE (DO'KON) VA GAMIFIKATSIYA COIN TIZIMI
// ==========================================

enum StoreItemCategory {
  DISCOUNT
  POWERUP
  AI_PERK
  COSMETIC
}

model StoreItem {
  id              String            @id @default(uuid())
  title           String
  description     String
  category        StoreItemCategory
  costCoins       Int
  icon            String            // "Percent", "Shield", "Zap", "Bot", "Sparkles", "Crown"
  badge           String?           // "Mashhur", "-50%", "Yangi", "VIP"
  discountPercent Int?
  durationDays    Int?
  actionKey       String?           // "PRO_DISCOUNT_10", "STREAK_FREEZE", "AI_KAIWA_WEEK", "FRAME_SAKURA"
  isAvailable     Boolean           @default(true)
  order           Int               @default(0)
  createdAt       DateTime          @default(now())

  inventoryItems  UserInventoryItem[]

  @@map("store_items")
}

model UserInventoryItem {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        StoreItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  code        String?   // Agar chegirma promokodi bo'lsa (masalan: "MINNA-10-XYZ")
  isUsed      Boolean   @default(false)
  expiresAt   DateTime?
  purchasedAt DateTime  @default(now())

  @@map("user_inventory_items")
}

model CoinTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // Musbat (+10) yoki Manfiy (-150)
  type        String   // "LESSON_COMPLETED", "MOCK_PASSED", "STORE_PURCHASE", "WELCOME_BONUS", "STREAK_BONUS"
  description String
  createdAt   DateTime @default(now())

  @@map("coin_transactions")
}

// ==========================================
// OBJECT STORAGE (CLOUDFLARE R2) METADATA
// ==========================================

enum FileUploadStatus {
  PENDING
  COMPLETED
  FAILED
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

model StoredFile {
  id           String           @id @default(uuid())
  userId       String?
  originalName String
  objectKey    String           @unique
  bucket       String
  category     String           // 'videos' | 'audio' | 'images' | 'avatars' | 'documents' | 'materials'
  mimeType     String
  size         Int
  visibility   FileVisibility   @default(PUBLIC)
  status       FileUploadStatus @default(PENDING)
  url          String?          // public URL agar PUBLIC bo'lsa, private bo'lsa null
  metadata     Json?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([category])
  @@index([status, createdAt])
  @@map("stored_files")
}

// ==========================================
// OBUNA VA TO'LOV TIZIMI (SUBSCRIPTIONS)
// ==========================================

enum SubscriptionTier {
  FREE
  MONTHLY
  QUARTERLY
  ANNUAL
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentProvider {
  PAYME
  CLICK
  UZUM
  STRIPE
  ADMIN_MANUAL
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model SubscriptionPlan {
  id           String           @id @default(uuid())
  tier         SubscriptionTier @default(MONTHLY)
  name         String
  nameRu       String?
  priceUzs     Int
  durationDays Int              // Masalan: 30 oylik, 90 uch oylik, 365 yillik, 36500 cheksiz
  features     Json             // Imkoniyatlar ro'yxati: string[]
  popular      Boolean          @default(false)
  tag          String?          // "Eng tejamkor", "Mashhur"
  order        Int              @default(0)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId        String?
  plan          SubscriptionPlan?  @relation(fields: [planId], references: [id], onDelete: SetNull)
  tier          SubscriptionTier   @default(MONTHLY)
  status        SubscriptionStatus @default(ACTIVE)
  startDate     DateTime           @default(now())
  endDate       DateTime
  autoRenew     Boolean            @default(false)
  cancelledAt   DateTime?
  paymentMethod PaymentProvider    @default(PAYME)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transactions  PaymentTransaction[]

  @@index([userId, status])
  @@map("user_subscriptions")
}

model PaymentTransaction {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId    String?
  subscription      UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  originalAmountUzs Int
  discountAmountUzs Int               @default(0)
  finalAmountUzs    Int
  provider          PaymentProvider   @default(PAYME)
  status            PaymentStatus     @default(PENDING)
  externalId        String?           // Payme transaction ID or Click trans_id
  promoCode         String?           // Do'kondan yoki umumiy chegirma kodi
  inventoryItemId   String?           // Agar do'kon vaucheri ishlatilgan bo'lsa
  metadata          Json?
  paidAt            DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId, status])
  @@map("payment_transactions")
}

model TeacherFeedback {
  id        String   @id @default(uuid())
  teacherId String
  studentId String
  courseId  String?
  lessonId  String?
  title     String?
  comment   String
  rating    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   User     @relation("TeacherFeedbackGiven", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User     @relation("StudentFeedbackReceived", fields: [studentId], references: [id], onDelete: Cascade)
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([teacherId])
  @@index([studentId])
  @@map("teacher_feedbacks")
}

