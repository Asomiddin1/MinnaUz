# MinnaUz MCP Server Configuration
NODE_ENV="development"
PORT=3002
HOST="0.0.0.0"

# MinnaUz NestJS API Base URL
MINNAUZ_API_URL="http://127.0.0.1:3001/api"

# MinnaUz Authorization Server & Protected Resource URLs
MINNAUZ_AUTH_SERVER_URL="https://api.minna.uz"
MCP_RESOURCE_URL="https://mcp.minna.uz"

# Request Timeout (Milliseconds)
API_TIMEOUT_MS=10000

# Optional Local Developer Token (for testing with STDIO transport)
DEV_BEARER_TOKEN=""

# CORS Allowed Origins (comma separated)
CORS_ORIGINS="http://localhost:3000,https://chatgpt.com,https://claude.ai"

